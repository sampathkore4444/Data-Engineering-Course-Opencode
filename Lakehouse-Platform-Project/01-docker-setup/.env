##############################################################################
# Banking Lakehouse Platform - Environment Variables
##############################################################################

# Dremio Configuration
DREMIO_VERSION=24.0
DREMIO_MASTER_MEMORY=8g
DREMIO_EXECUTOR_MEMORY=6g

# MinIO (S3-Compatible Storage)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_RAW=banking-raw
MINIO_BUCKET_BRONZE=banking-bronze
MINIO_BUCKET_SILVER=banking-silver
MINIO_BUCKET_GOLD=banking-gold

# Kafka Configuration
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092

# PostgreSQL - Source System
POSTGRES_SOURCE_DB=banking_source
POSTGRES_SOURCE_USER=banking_admin
POSTGRES_SOURCE_PASSWORD=banking_secure_2024

# PostgreSQL - Iceberg Catalog
POSTGRES_ICEBERG_DB=iceberg_catalog
POSTGRES_ICEBERG_USER=iceberg_admin
POSTGRES_ICEBERG_PASSWORD=iceberg_secure_2024

# PostgreSQL - Airflow
POSTGRES_AIRFLOW_DB=airflow
POSTGRES_AIRFLOW_USER=airflow
POSTGRES_AIRFLOW_PASSWORD=airflow

# Airflow
AIRFLOW_FERNET_KEY=81HqDtbqAywKSOumSha3BhWNOdQ26slT6K0YaZeZyPs=
AIRFLOW_DAGS_DIR=./dags

# Monitoring
PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
